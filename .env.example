# ============================================================
# AI Business Workflow Automation System - 环境变量样例
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# ============================================================

# ---------- n8n 基础 ----------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# 公网访问时改成你的域名，例如 https://n8n.your-domain.com
WEBHOOK_URL=http://localhost:5678/
# 基本时区（影响工单时间、调度）
GENERIC_TIMEZONE=Asia/Shanghai
# 基础认证（首次登录用）
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-please

# ============================================================
# AI 模型提供商（国内访问关键）
# 选一个填进去即可，n8n 里 OpenAI 节点的 Base URL 也跟着改
# ============================================================
# 可选项：openai | deepseek | qwen | zhipu | moonshot

# ============================================================
# n8n 工作流实际读取的三个变量（OpenAI 兼容直通）
# 模型节点参数已内嵌表达式 $env.LLM_MODEL，默认 DeepSeek。
# 切换模型只改这三行 + MODEL_PROVIDER，无需改 n8n 节点。
# n8n 凭据配置：Base URL 填  {{ $env.OPENAI_BASE_URL }}
#              API Key 填  {{ $env.OPENAI_API_KEY }}
# ============================================================
# 国内用户默认用 DeepSeek（可直连）；改其他家就换成对应地址与模型名
LLM_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# 国内用户请不要用 openai（api.openai.com 不可直连）
MODEL_PROVIDER=deepseek

# ---- 1) DeepSeek（国内直连，最便宜，推荐）----
# 申请：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- 2) 通义千问（阿里云百炼，OpenAI 兼容模式）----
# 申请：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# ---- 3) 智谱 GLM（智谱 AI，OpenAI 兼容）----
# 申请：https://open.bigmodel.cn/
ZHIPU_API_KEY=xxxxxxxx.xxxxxxxx
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# ---- 4) 月之暗面 Kimi（OpenAI 兼容）----
# 申请：https://platform.moonshot.cn/
MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxx
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k

# ---- 5) 官方 OpenAI（海外服务器/已解决网络时用）----
# 注意：工作流实际读取的是上方 LLM_MODEL / OPENAI_BASE_URL / OPENAI_API_KEY 三行。
# 想用官方 OpenAI 时，把上面三行的值改成：
#   模型名 gpt-4o-mini、地址 https://api.openai.com/v1、密钥改为官方 key，
# 并把 MODEL_PROVIDER=openai。不要在这里重复定义 OPENAI_*（重复定义会导致 dotenv 取到旧值）。

# ============================================================
# 飞书开放平台（国内原生可达，无需代理）
# 申请：https://open.feishu.cn/  自建应用 → 开通权限 bitable:app, im:message
# ============================================================
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_BITABLE_APP_TOKEN=bascnXXXXXXXXXXXXXXXX
FEISHU_BITABLE_TABLE_ID=tblXXXXXXXXXXXX
FEISHU_OWNER_USER_ID=ou_xxxxxxxxxxxxxxxxxxxx

# ============================================================
# 业务侧（工单通知等）
# ============================================================
# 表单提交后回给前端的成功提示
INBOX_SUCCESS_MESSAGE=已受理

# ============================================================
# RAG 知识库检索（2026-10 升级新增）
# 真实部署：把 simulation/knowledge-base.md 导入向量库（Qdrant/pgvector/飞书知识库），
# 再用检索服务暴露 /search 接口。演示模式可暂时留空（摘要自动跳过增强，不影响主流程）。
# ============================================================
# 例：https://your-kb-server/search
KB_SEARCH_URL=
KB_TOP_K=3
